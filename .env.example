# Copy to .env. Everything works with NO keys (local trained intent model + rules + templates).
# You do NOT need Claude. Sarvam alone covers every LLM job; add one free OpenAI-compatible provider for an independent critic.

# --- Sarvam AI (hackathon partner): Indic chat/reasoning/tool-calling, translation, speech-to-text, text-to-speech
SARVAM_API_KEY=
# SARVAM_TTS_MODEL=bulbul:v3          # or bulbul:v4-flash (then set SARVAM_TTS_SPEAKER= to a persona id, or leave empty)
# SARVAM_TTS_SPEAKER=priya
# SARVAM_STT_MODEL=saaras:v4

# --- Optional: ANY OpenAI-compatible provider (free tiers / local). Fill all three, leave the rest.
# Option A: Groq (free tier, fast)            https://console.groq.com
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile
# Option B: Google Gemini (free tier)         https://aistudio.google.com/apikey
# OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_COMPAT_MODEL=gemini-2.5-flash
# Option C: OpenRouter (:free models)         https://openrouter.ai/keys
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Option D: Ollama, 100% local and free       https://ollama.com   (run: ollama pull qwen2.5:7b)
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_MODEL=qwen2.5:7b
# OPENAI_COMPAT_API_KEY=

# --- Anthropic Claude (optional, leave empty if credits are exhausted)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# LLM_MODE=auto            # auto | offline (force local-only)
# RESOLVE_PACE=0.45        # seconds between streamed agent steps (0 = instant)
# RESOLVE_GATE_SECRET=change-me
# HOST=127.0.0.1
# PORT=8001
